{
  "name": "finclis",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "monzo": "bun run --cwd packages/monzo monzo",
    "trading212": "bun run --cwd packages/trading212 trading212",
    "wise": "bun run --cwd packages/wise wise",
    "vanguard": "bun run --cwd packages/vanguard vanguard",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "compile": "bun run --filter '*' compile"
  }
}
